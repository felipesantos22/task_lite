@model IEnumerable<taskmvc.Models.TaskName>

<div class="text-center">
    <h1 class="display-4">Lista de Tarefas</h1>
    <p>Crie sua lista de tarefas</p>
</div>

<a asp-action="Create" class="btn btn-dark mb-3">
    <i class="bi bi-plus"></i>
</a>

<table class="table">
    <thead>
    <tr>
        <th>Id</th>
        <th>Nome</th>
    </tr>
    </thead>

    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>
                <a asp-action="Edit"
                   asp-route-id="@item.Id"
                   class="btn btn-warning">
                    Editar
                </a>

                <a asp-action="Delete"
                   asp-route-id="@item.Id"
                   class="btn btn-danger">
                    Excluir
                </a>
            </td>
        </tr>
    }
    </tbody>
</table>