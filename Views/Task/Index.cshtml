@model IEnumerable<taskmvc.Models.TaskName>

<div class="text-center">
    <h1 class="display-4">Lista de Tarefas</h1>
    <p>Crie sua lista de tarefas</p>
</div>

<a asp-action="Create" class="btn btn-dark mb-3">
    <i class="bi bi-plus"></i>
</a>

<table class="table">
    <thead>
    <tr>
        <th>Id</th>
        <th>Nome</th>
        <th class="text-md-end">Ações</th>
    </tr>
    </thead>

    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-info">
                        Editar
                    </a>
                    @*
                    <form asp-action="DeleteConfirmed"
                          asp-route-id="@item.Id"
                          method="post">

                        <button type="submit" class="btn btn-danger">
                            Excluir
                        </button>
                    </form>
                    *@
                    <button type="button"
                            onclick="deleteTask(@item.Id)"
                            class="btn btn-secondary">
                        <strong>Delete</strong>
                    </button>
                </div>
            </td>
        </tr>
    }
    </tbody>
</table>

@section Scripts {
    <script src="~/js/delete.js"></script>
}